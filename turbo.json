{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.json", "biome.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {},
    "test:integration": {
      "cache": false
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "tsc": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
