{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/dist/**",
      "!**/.expo/**",
      "!**/ios/Pods/**",
      "!**/ios/build/**",
      "!**/android/.gradle/**",
      "!**/android/build/**",
      "!**/.next/**",
      "!**/out/**",
      "!**/coverage/**",
      "!**/routeTree.gen.ts",
      "!lint/__fixtures__/**"
    ]
  },
  "plugins": [
    {
      "path": "./lint/no-instant-day-math.grit",
      "resolutionKind": "config",
      "includes": [
        "**",
        "!**/__tests__/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!packages/shared/src/domains/care/care-day.ts"
      ]
    },
    {
      "path": "./lint/assert-which-error.grit",
      "resolutionKind": "config",
      "includes": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"]
    },
    {
      "path": "./lint/eager-require-actual.grit",
      "resolutionKind": "config",
      "includes": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"]
    },
    {
      "path": "./lint/query-key-from-factory.grit",
      "resolutionKind": "config",
      "includes": ["packages/app/**", "packages/admin/**"]
    },
    {
      "path": "./lint/one-chrome-launch.grit",
      "resolutionKind": "config",
      "includes": ["**", "!packages/web/scripts/chrome.ts"]
    },
    {
      "path": "./lint/exact-query-key.grit",
      "resolutionKind": "config",
      "includes": ["packages/app/**"]
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noShadowRestrictedNames": "off",
        "noUnknownAtRules": {
          "level": "error",
          "options": { "ignore": ["tailwind"] }
        },
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "enabled": false
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "overrides": [
    {
      "includes": ["packages/web/src/components/home/home.css"],
      "linter": {
        "rules": { "style": { "noDescendingSpecificity": "off" } }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/__tests__/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off",
            "noReactNativeRawText": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
