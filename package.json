{
  "name": "lily-monorepo",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@babel/runtime": "^7.29.10",
    "@biomejs/biome": "2.6.2",
    "@effect/tsgo": "0.56.0",
    "@railway/cli": "5.70.0",
    "husky": "^9.1.7",
    "railway": "3.16.0",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.3",
  "private": true,
  "resolutions": {
    "effect": "4.0.5",
    "react": "19.3.0",
    "vite": "^8.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "test:integration": "bun --env-file=.env.test.local run --filter=@lily/api test:integration",
    "db:setup-test": "bun --env-file=.env.test.local run --filter=@lily/db db:setup-test",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "tsc": "turbo tsc",
    "tsc:build": "tsc --build --verbose",
    "clean": "turbo clean",
    "prepare": "husky && effect-tsgo patch --typescript --no-oxlint"
  },
  "workspaces": [
    "packages/*"
  ]
}
