echo "🔍 Running pre-push checks..."

echo "📚 Checking doc references..."
bash scripts/check-docs.sh
if [ $? -ne 0 ]; then
    echo "❌ A doc points at a file or link that does not exist. Fix the paths listed above."
    exit 1
fi
echo "✅ Docs passed!"

echo "🗄️ Checking migrations..."
bash scripts/check-migrations.sh
if [ $? -ne 0 ]; then
    echo "❌ A migration shares a number or leaves its lock waits unbounded. Fix the files listed above."
    exit 1
fi
echo "✅ Migrations passed!"

# Run linting
echo "📝 Running lint..."
bun run lint
if [ $? -ne 0 ]; then
    echo "❌ Linting failed! Please fix the issues before pushing."
    echo "💡 Run 'bun run lint:fix' to automatically fix some issues."
    exit 1
fi
echo "✅ Lint passed!"

# Run type checking
echo "🔷 Running type check..."
bun run tsc
if [ $? -ne 0 ]; then
    echo "❌ Type checking failed! Please fix the type errors before pushing."
    exit 1
fi
echo "✅ Type check passed!"

# Run tests
echo "🧪 Running tests..."
bun run test
if [ $? -ne 0 ]; then
    echo "❌ Tests failed! Please fix failing tests before pushing."
    exit 1
fi
echo "✅ Tests passed!"

echo "✅ All pre-push checks passed! Proceeding with push..." 