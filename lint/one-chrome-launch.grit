// Each copy of the Chrome launch drifted on its own: one waited 60 s, four
// waited 10 s, and none kept Chrome's stderr, so a slow cold start on CI
// failed with no cause (#386). biome.json skips chrome.ts, the one launcher.
language js

or {
  JsStringLiteralExpression() as $flag where {
    $flag <: r"[\s\S]*--remote-debugging-(?:port|pipe)[\s\S]*"
  },
  JsTemplateExpression() as $flag where {
    $flag <: r"[\s\S]*--remote-debugging-(?:port|pipe)[\s\S]*"
  },
  `$launch($command, $...)` where {
    $launch <: or {
      `Bun.spawn`,
      `Bun.spawnSync`,
      `spawn`,
      `spawnSync`,
      `execFile`,
      `execFileSync`,
      `exec`,
      `execSync`
    },
    $command <: r"(?:\[\s*)?[^,\[]*?(?i:chrom(?:e|ium))[\s\S]*"
  }
} as $hit where {
  register_diagnostic(span=$hit, message="Launch Chrome through launchChrome() in packages/web/scripts/chrome.ts. It reports why Chrome did not start and stops Chrome when the script exits.")
}
