// A test that asserts only that an effect failed passes on any error, so a
// change that fails it for another reason goes unseen.
language js

or {
  `expect($asserted)` where {
    $asserted <: contains or {
      `Exit.isFailure($_)`,
      `Exit.hasFails($_)`,
      `Exit.hasDies($_)`,
      `Cause.hasFails($_)`,
      `Cause.hasDies($_)`,
      `Result.isFailure($_)`
    }
  },
  `expect(Exit.isSuccess($_)).$matcher(false)`,
  `expect(Result.isSuccess($_)).$matcher(false)`,
  `expect($exit._tag).$matcher('Failure')`,
  `expect($_).rejects.$matcher()` where { $matcher <: or { `toThrow`, `toThrowError` } },
  `expect(failureOf($_)).toMatchObject({ $props })` where {
    $props <: not some `_tag: $_`
  }
} as $hit where {
  register_diagnostic(span=$hit, message="Assert which error failed: use failureOf(exit or result) and check its _tag or class (Exit.isFailure, a toMatchObject without _tag or a bare rejects.toThrow() passes on any error).")
}
