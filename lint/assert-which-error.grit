// A test that asserts only that an effect failed passes on any error, so a
// change that fails it for another reason goes unseen.
language js

or {
  or {
    `expect($asserted)` where {
      $asserted <: contains or {
        `Exit.isFailure($_)`,
        `Exit.hasFails($_)`,
        `Exit.hasDies($_)`,
        `Cause.hasFails($_)`,
        `Cause.hasDies($_)`,
        `Result.isFailure($_)`
      }
    },
    `expect(Exit.isSuccess($_)).$matcher(false)`,
    `expect(Result.isSuccess($_)).$matcher(false)`,
    `expect($exit._tag).$matcher('Failure')`,
    `expect($_).rejects.$matcher()` where { $matcher <: or { `toThrow`, `toThrowError` } },
    `expect(failureOf($_)).toMatchObject({ $props })` where {
      $props <: not some `_tag: $_`
    }
  } as $hit where {
    register_diagnostic(span=$hit, message="Assert which error failed: use failureOf(exit or result) and check its _tag or class (Exit.isFailure, a toMatchObject without _tag or a bare rejects.toThrow() passes on any error).")
  },
  // An error's message is not enumerable, so these matchers skip it. The rule
  // sees only an error built inside the expect call, not one held in a table
  // or a variable.
  `expect($_).$matcher($expected)` as $hit where {
    $matcher <: or { `toEqual`, `toStrictEqual`, `toMatchObject` },
    $expected <: contains `new $class({ $props })` where {
      $class <: r".*(?:Error|Defect)",
      $props <: some `message: $_`
    },
    register_diagnostic(span=$hit, message="toEqual, toStrictEqual and toMatchObject skip an error's message, which is not enumerable. Match a plain object with _tag and message, or check error.message with toBe.")
  }
}
