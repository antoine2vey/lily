{
  "name": "@lily/mcp",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "MCP server for Lily plant care",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "lint": "bunx --bun biome check .",
    "lint:fix": "bunx --bun biome check --write .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.5",
    "@lily/db": "workspace:*",
    "@lily/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.0.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
