{
  "name": "@lily/api",
  "version": "1.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Node.js API with Effect RPC",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/__tests__/integration --no-file-parallelism",
    "lint": "bunx --bun biome check .",
    "lint:fix": "bunx --bun biome check --write .",
    "clean": "rm -rf dist",
    "seed:knowledge": "bun run scripts/seed-houseplant-knowledge.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.25",
    "@effect/platform-bun": "^4.0.0",
    "@lily/db": "workspace:*",
    "@lily/knowledge-db": "workspace:*",
    "@lily/shared": "workspace:*",
    "@mozilla/readability": "^0.6.0",
    "ai": "^6.0.68",
    "apple-signin-auth": "^2.0.0",
    "drizzle-orm": "^0.45.1",
    "effect": "^4.0.0",
    "expo-server-sdk": "^4.0.0",
    "google-auth-library": "^9.15.0",
    "ioredis": "^5.9.1",
    "jose": "^6.1.3",
    "linkedom": "^0.18.12",
    "octokit": "^5.0.5",
    "qrcode-terminal": "^0.12.0",
    "resend": "^6.7.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "pg": "^8.16.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
