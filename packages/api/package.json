{
  "name": "@lily/api",
  "version": "1.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Node.js API with Effect RPC",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/__tests__/integration --no-file-parallelism",
    "lint": "bunx --bun biome check .",
    "lint:fix": "bunx --bun biome check --write .",
    "clean": "rm -rf dist",
    "seed:knowledge": "bun run scripts/seed-houseplant-knowledge.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.131",
    "@effect/platform-bun": "^4.0.5",
    "@lily/db": "workspace:*",
    "@lily/knowledge-db": "workspace:*",
    "@lily/shared": "workspace:*",
    "@mozilla/readability": "^0.6.0",
    "ai": "^6.0.312",
    "apple-signin-auth": "^2.1.0",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.0.5",
    "expo-server-sdk": "^7.2.0",
    "google-auth-library": "^11.3.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "linkedom": "^0.18.14",
    "octokit": "^5.0.5",
    "qrcode-terminal": "^0.12.0",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^5.0.5",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
