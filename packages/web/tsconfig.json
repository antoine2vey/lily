{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "effect/ai",
          "effect/FileSystem",
          "effect/http",
          "effect/http-api",
          "effect/observability",
          "effect/Path",
          "effect/PlatformError",
          "effect/sql",
          "@effect/platform-bun",
          "@effect/sql-pg"
        ]
      }
    ]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
