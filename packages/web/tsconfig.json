{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [
      { "name": "next" },
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "effect/ai",
          "effect/FileSystem",
          "effect/http",
          "effect/http-api",
          "effect/observability",
          "effect/Path",
          "effect/PlatformError",
          "effect/sql",
          "@effect/platform-bun",
          "@effect/sql-pg"
        ]
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
