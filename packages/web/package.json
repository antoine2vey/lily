{
  "name": "@lily/web",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "bun scripts/build-search-index.ts && next build",
    "build:search-index": "bun scripts/build-search-index.ts",
    "start": "bunx http-server out -p $PORT -a 0.0.0.0 --proxy http://0.0.0.0:$PORT?",
    "tsc": "tsc --noEmit",
    "test": "echo 'No tests yet'",
    "lint": "bunx --bun biome check .",
    "lint:fix": "bunx --bun biome check --write .",
    "optimize-images": "bun run scripts/optimize-images.ts"
  },
  "dependencies": {
    "@next/third-parties": "^16.4.2",
    "effect": "^4.0.5",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reading-time": "^1.5.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.2.3",
    "postcss": "^8.5.31",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
