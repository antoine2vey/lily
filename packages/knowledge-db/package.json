{
  "name": "@lily/knowledge-db",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Knowledge base database schema and client (pgvector)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "tsc": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "bunx --bun biome check .",
    "lint:fix": "bunx --bun biome check --write .",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "bun run scripts/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@effect/sql-pg": "^4.0.5",
    "@lily/db": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.0.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
